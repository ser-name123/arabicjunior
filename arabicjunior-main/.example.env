# Copy to .env.local (or .env) and fill in real values. Never commit it.
#
# Everything here is NEXT_PUBLIC_*, which means it is compiled into the pages
# and visible to anyone who opens the site. Only put values here that are meant
# to be public — secrets belong in the API's own .env.

# --- API ---
# Where the Express API is reachable, with no trailing slash.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
# NEXT_PUBLIC_API_BASE_URL=https://api.arabicjuniors.com

# --- Google sign-in ---
# The OAuth client id from console.cloud.google.com. Must be the same value as
# GOOGLE_CLIENT_ID in the API's .env, or every sign-in is rejected.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Cloudflare Turnstile ---
# The site key for the widget, from dash.cloudflare.com > Turnstile.
# Pairs with TURNSTILE_SECRET_KEY in the API's .env. Leave both blank to turn
# the captcha off entirely; the forms keep working, just unprotected.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
