# Copy to .env and fill in real values. Never commit .env.
#
# Generate the two secrets below with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Do NOT copy placeholder values from this file into a real environment.

# --- Server ---
# The API listens here. Hosting platforms (Render, Heroku) inject their own
# PORT; leave it unset there and the app falls back correctly.
PORT=5000
NODE_ENV=development

# --- Database ---
# The path segment after the host IS the database name. Leave it out and the
# driver silently falls back to a database called "test".
MONGODB_URI=mongodb://localhost:27017/arabicjuniors
# Atlas form:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/arabicjuniors?retryWrites=true&w=majority

# --- Secrets (64+ random bytes each, never reuse across environments) ---
JWT_SECRET=
SESSION_SECRET=

# Emergency override for resetting an admin's 2FA. Must be at least 64
# characters or the endpoint refuses to run.
MASTER_2FA_RESET_KEY=

# --- Frontend origin, for CORS and the auth cookie ---
# Required — the server exits at boot if this is unset.
# Accepts a comma-separated list, e.g. apex plus www.
CLIENT_URL=http://localhost:3005
# CLIENT_URL=https://arabicjuniors.com,https://www.arabicjuniors.com

# --- Email (Brevo) ---
# Two ways in; set ONE of them. SMTP is preferred and is tried first.
#
#   SMTP relay:  Brevo -> SMTP & API -> SMTP tab.
#                Login looks like 9xxxxx@smtp-brevo.com, the key like xsmtpsib-...
#   HTTP API:    same page, "API keys" tab. Key looks like xkeysib-...
#
# Prefer the HTTP API if the host blocks outbound SMTP ports (some PaaS plans
# do). Leaving the SMTP pair blank makes the API key take over on its own.
#
# With neither set, every email is dropped and a warning is logged once.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=

BREVO_V1_API_KEY=

# Must be an address verified as a sender in Brevo, or everything bounces.
BREVO_VERIFIED_SENDER_EMAIL=hello@arabicjuniors.com

# Who receives enquiry/registration notifications. Comma-separated.
# Leave unset to keep the addresses hard-coded in sendEmailToAdmin.ts.
# ADMIN_NOTIFY_TO=imran.gauri@gmail.com,rafat@arabicjuniors.com
# ADMIN_NOTIFY_BCC=

# --- Media (Cloudinary) ---
# Server-side signed uploads only. The frontend never talks to Cloudinary
# directly, so no NEXT_PUBLIC_* Cloudinary values are needed anywhere.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudflare Turnstile secret, from dash.cloudflare.com > Turnstile > your widget.
# Leave blank to disable captcha verification (forms keep working, unprotected).
TURNSTILE_SECRET_KEY=

# --- Google sign-in ---
# The OAuth client id from console.cloud.google.com. The frontend needs the
# same value as NEXT_PUBLIC_GOOGLE_CLIENT_ID; the server verifies the token
# Google issued against this id, so a mismatch rejects every sign-in.
GOOGLE_CLIENT_ID=

# --- Chatbot AI (optional) ---
# The website chatbot answers with AI when one of these is set. Without a key
# it still works: it falls back to the admin's own questions and answers and to
# keyword matching over the site's content, so nothing breaks while this is
# blank. Set ONE of them. If both are set, Anthropic wins.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: point at a gateway or spend-capped proxy instead of the provider.
ANTHROPIC_BASE_URL=
OPENAI_BASE_URL=
