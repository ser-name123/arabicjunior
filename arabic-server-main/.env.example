# Copy to .env and fill in real values. Never commit .env.
#
# Generate the two secrets below with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Do NOT copy placeholder values from this file into a real environment.

# --- Server ---
# The API listens here. Hosting platforms (Render, Heroku) inject their own
# PORT; leave it unset there and the app falls back correctly.
PORT=5000
NODE_ENV=development

# --- Database ---
# The path segment after the host IS the database name. Leave it out and the
# driver silently falls back to a database called "test".
MONGODB_URI=mongodb://localhost:27017/arabicjuniors
# Atlas form:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/arabicjuniors?retryWrites=true&w=majority

# --- Secrets (64+ random bytes each, never reuse across environments) ---
JWT_SECRET=
SESSION_SECRET=

# Emergency override for resetting an admin's 2FA. Must be at least 64
# characters or the endpoint refuses to run.
MASTER_2FA_RESET_KEY=

# --- Frontend origin, for CORS and the auth cookie ---
# Required — the server exits at boot if this is unset.
# Accepts a comma-separated list, e.g. apex plus www.
CLIENT_URL=http://localhost:3005
# CLIENT_URL=https://arabicjuniors.com,https://www.arabicjuniors.com

# --- Email (Brevo) ---
# Without a working key, registration saves the record and then fails on the
# confirmation email, returning a 500 to the visitor.
BREVO_V1_API_KEY=
BREVO_VERIFIED_SENDER_EMAIL=hello@arabicjuniors.com

# --- Media (Cloudinary) ---
# Server-side signed uploads only. The frontend never talks to Cloudinary
# directly, so no NEXT_PUBLIC_* Cloudinary values are needed anywhere.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudflare Turnstile secret, from dash.cloudflare.com > Turnstile > your widget.
# Leave blank to disable captcha verification (forms keep working, unprotected).
TURNSTILE_SECRET_KEY=
